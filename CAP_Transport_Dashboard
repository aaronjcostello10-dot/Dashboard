                   "New Motor Cycles", "Secondhand Private Cars"), each = 28),
      Count = NA_integer_
    )
  })
  
  # Private car fleet by fuel type — from THA17 (already fetched for car_indicators)
  cat("Fetching private car fleet by fuel type from CSO THA17...\n")
  car_fleet_fuel <- tryCatch({
    tha17_raw <- cso_get_data("THA17")
    tha17_raw %>%
      filter(Statistic == "Vehicle Population") %>%
      filter(Type.of.Vehicle == "Private cars") %>%
      filter(County.of.Ownership == "Ireland") %>%
      filter(Year.of.Registration == "All years") %>%
      filter(Fuel.Type != "All fuel types") %>%
      pivot_longer(
        cols = -c(Statistic, Fuel.Type, Type.of.Vehicle,
                  County.of.Ownership, Year.of.Registration),
        names_to = "Year", values_to = "Count"
      ) %>%
      mutate(Year = as.integer(Year), Fuel = Fuel.Type) %>%
      filter(!is.na(Count)) %>%
      select(Year, Fuel, Count) %>%
      arrange(Fuel, Year)
  }, error = function(e) {
    cat("✗ THA17 fleet-by-fuel failed:", conditionMessage(e), "\n")
    data.frame(
      Year = rep(2015:2023, 3),
      Fuel = rep(c("Petrol", "Diesel", "Other fuel types"), each = 9),
      Count = c(
        820000, 790000, 770000, 755000, 745000, 740000, 735000, 725000, 710000,  # Petrol
        1100000, 1170000, 1230000, 1280000, 1320000, 1345000, 1360000, 1365000, 1370000,  # Diesel
        72000, 78000, 85000, 95000, 108000, 130000, 160000, 200000, 245000  # Other (EVs + hybrids)
      )
    )
  })
  
  list(
    vehicle_licensing = vehicle_licensing,
    total_fleet = total_fleet,
