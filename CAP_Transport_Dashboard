    RTFO_Obligation_Pct = c( 6.0,  6.0,  7.0,  8.0,  9.0, 10.0, 10.0)
  )
  
  # ============================================================================
  # IMPROVE TAB DATA FETCHES — verified live against CSO PxStat API
  # ============================================================================
  
  # New/secondhand private cars by fuel type (TEM27) — monthly 2021-2026
  cat("Fetching new/secondhand private cars by fuel type from CSO TEM27...\n")
  new_cars_fuel <- tryCatch({
    tem27_raw <- cso_get_data("TEM27")
    tem27_raw %>%
      filter(Licensing.Authority == "All licensing authorities") %>%
      filter(Type.of.Fuel != "All fuel types") %>%
      pivot_longer(
        cols = -c(Statistic, Licensing.Authority, Type.of.Fuel),
        names_to = "Month", values_to = "Count"
      ) %>%
      mutate(
        Year = as.integer(substr(Month, 1, 4)),
        Fuel = Type.of.Fuel,
        Category = Statistic
      ) %>%
      filter(!is.na(Count)) %>%
      group_by(Year, Category, Fuel) %>%
      summarise(Count = sum(Count, na.rm = TRUE), .groups = "drop") %>%
      arrange(Category, Fuel, Year)
  }, error = function(e) {
    cat("✗ TEM27 failed:", conditionMessage(e), "\n")
    # Fallback: rough shares matching SIMI/ZEVI published figures
    expand.grid(
      Year = 2021:2024,
      Category = c("New Private Cars", "Secondhand Private Cars"),
      Fuel = c("Petrol", "Diesel", "Petrol and electric hybrid", "Electric",
               "Petrol or Diesel plug-in hybrid electric", "Diesel and electric hybrid", "Other fuel types"),
      stringsAsFactors = FALSE
    ) %>%
      mutate(Count = case_when(
        Category == "New Private Cars" & Fuel == "Petrol"                               ~ c(33000,36000,35000,34000)[Year - 2020],
        Category == "New Private Cars" & Fuel == "Diesel"                               ~ c(28000,25000,20000,16000)[Year - 2020],
        Category == "New Private Cars" & Fuel == "Petrol and electric hybrid"           ~ c(15000,18000,21000,24000)[Year - 2020],
        Category == "New Private Cars" & Fuel == "Electric"                             ~ c( 8646,15678,22783,16786)[Year - 2020],
        Category == "New Private Cars" & Fuel == "Petrol or Diesel plug-in hybrid electric" ~ c( 6800, 9500,10500, 9500)[Year - 2020],
        Category == "New Private Cars" & Fuel == "Diesel and electric hybrid"           ~ c(   50,  100,  150,  200)[Year - 2020],
        Category == "New Private Cars" & Fuel == "Other fuel types"                     ~ c(  200,  250,  300,  350)[Year - 2020],
        Category == "Secondhand Private Cars" & Fuel == "Petrol"                        ~ c(25000,28000,30000,31000)[Year - 2020],
        Category == "Secondhand Private Cars" & Fuel == "Diesel"                        ~ c(36000,40000,38000,35000)[Year - 2020],
        Category == "Secondhand Private Cars" & Fuel == "Petrol and electric hybrid"    ~ c( 6000, 7500, 9000,11000)[Year - 2020],
        Category == "Secondhand Private Cars" & Fuel == "Electric"                      ~ c( 1200, 2400, 3800, 5200)[Year - 2020],
        Category == "Secondhand Private Cars" & Fuel == "Petrol or Diesel plug-in hybrid electric" ~ c(  900, 1300, 1700, 2100)[Year - 2020],
        Category == "Secondhand Private Cars" & Fuel == "Diesel and electric hybrid"    ~ c(   20,   40,   60,   80)[Year - 2020],
        Category == "Secondhand Private Cars" & Fuel == "Other fuel types"              ~ c(  100,  120,  140,  160)[Year - 2020],
        TRUE ~ 0
      ))
  })
  
  # Vehicles licensed for the first time — annual long trend (TEA01) 1997-2025
  # NB: TEA01 uses uppercase STATISTIC column name (unlike most other CSO tables)
  cat("Fetching long-run vehicles licensed from CSO TEA01...\n")
  vehicles_licensed_long <- tryCatch({
    tea01_raw <- cso_get_data("TEA01")
    tea01_raw %>%
