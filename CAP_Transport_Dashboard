                  tags$li(tags$b("First sectoral carbon budget 2021–2025"), " = 54 MtCO₂eq; 64.1% expended by end 2023."),
                  tags$li(tags$b("Second sectoral carbon budget 2026–2030"), " = 37 MtCO₂eq.")
                ),
                
                p(tags$i("This dashboard presents observed CSO data against CAP 2025 policy targets to show Ireland's progress across the three ASI pillars."))
            )
          )
        )
      )
    )
  )
)

