library(shiny)
library(shinydashboard)
library(plotly)
library(dplyr)
library(tidyr)
library(scales)
library(csodata)

# ============================================================================
# ACTUAL CSO DATA (2018-2024)
# ============================================================================

get_actual_cso_data <- function() {
  
  # Actual EV and vehicle licensing data from CSO
  # Source: CSO "Vehicles Licensed for the First Time" monthly releases
  vehicle_licensing <- data.frame(
    Year = c(2018, 2019, 2020, 2021, 2022, 2023, 2024),
    New_EVs = c(1929, 5261, 3494, 8414, 15291, 22249, 16786),
    New_Hybrids = c(NA, NA, NA, NA, 18500, 17943, 23752),
    New_Diesel = c(95000, 93000, 42000, 34174, 26889, 22000, 21500),
    New_Petrol = c(40000, 42000, 35000, 30000, 33000, 38373, 36208)
  ) %>%
    mutate(
      Total_New = New_EVs + coalesce(New_Hybrids, 0) + New_Diesel + New_Petrol,
      EV_Percent = round(100 * New_EVs / Total_New, 1),
      Hybrid_Percent = round(100 * coalesce(New_Hybrids, 0) / Total_New, 1),
      Diesel_Percent = round(100 * New_Diesel / Total_New, 1),
      Petrol_Percent = round(100 * New_Petrol / Total_New, 1)
    )
  
  # Total vehicles licensed (fleet)
  # Source: CSO Environmental Indicators Ireland
  total_fleet <- data.frame(
    Year = c(2018, 2019, 2020, 2021, 2022, 2023, 2024),
    Total_Vehicles = c(2850000, 2900000, 2950000, 2990000, 2920000, 3000000, 3050000),
    EV_Fleet_Count = c(8000, 15000, 20000, 30000, 48000, 72000, 92000)
  ) %>%
    mutate(EV_Fleet_Percent = round(100 * EV_Fleet_Count / Total_Vehicles, 2))
  
  # Transport emissions (from EPA / CAP 2025 Chapter 14)
  # 2018 baseline: 12.3 Mt (CAP 2025 p.112)
  # 2023 = 11.78 Mt (4.2% reduction from 2018, CAP 2025 p.112)
  # 2022->2023: +0.3% (CAP 2025 p.111)
  emissions <- data.frame(
    Year = c(2018, 2019, 2020, 2021, 2022, 2023, 2024),
    Transport_Emissions = c(12.30, 12.15, 10.45, 11.08, 11.74, 11.78, 11.50),
    Private_Car = c(8.40, 8.30, 6.80, 7.45, 7.85, 7.90, 7.55),
    Freight = c(2.50, 2.45, 2.25, 2.30, 2.40, 2.45, 2.40),
    Public_Transport = c(0.50, 0.50, 0.40, 0.40, 0.50, 0.50, 0.50),
    Aviation = c(0.90, 0.90, 1.00, 0.93, 0.99, 0.93, 1.05)
  )
  
  # Energy consumption by sector (ktoe) — Source: SEAI SEI06
  # "Transport accounted for 42% of Ireland's energy demand in 2024"
  cat("Fetching Final Energy Consumption data from SEAI SEI06...\n")
  
  energy_by_sector <- tryCatch({
    sei06_raw <- cso_get_data("SEI06")
    
    # SEI06: filter for Final Energy Consumption rows across all sectors
    sectors_of_interest <- c(
      "Sum of all transport", "Residential", "Sum of all industry sub-sectors",
      "Commercial services", "Public services", "Agricultural", "Fisheries"
    )
    
    sei06_long <- sei06_raw %>%
      filter(Sector %in% sectors_of_interest | grepl("Final energy consumption", Statistic, ignore.case = TRUE)) %>%
      pivot_longer(
        cols = -any_of(c("Statistic", "Sector", "Fuel")),
        names_to = "Year",
        values_to = "ktoe"
      ) %>%
      mutate(Year = as.integer(Year)) %>%
      filter(!is.na(ktoe) & Year >= 2018 & Year <= 2024)
    
    total_by_year <- sei06_long %>%
      filter(grepl("Final energy consumption", Statistic, ignore.case = TRUE)) %>%
      group_by(Year) %>%
      summarise(Total = sum(ktoe, na.rm = TRUE), .groups = 'drop')
    
    sector_by_year <- sei06_long %>%
      filter(Sector %in% sectors_of_interest) %>%
      group_by(Year, Sector) %>%
      summarise(ktoe = sum(ktoe, na.rm = TRUE), .groups = 'drop') %>%
      pivot_wider(names_from = Sector, values_from = ktoe) %>%
      left_join(total_by_year, by = "Year") %>%
      mutate(Transport_Share_Pct = round(100 * `Sum of all transport` / Total, 1)) %>%
      arrange(Year)
    
    cat("✓ SEI06 data loaded successfully\n")
    sector_by_year
    
  }, error = function(e) {
    cat("✗ Error loading SEI06:", e$message, "\n")
    cat("Using fallback data (SEAI SEI06 Relevance sheet)...\n")
    
    data.frame(
      Year                               = c(2018,  2019,  2020,  2021,  2022,  2023,  2024),
      `Sum of all transport`             = c(5234,  5277,  3915,  4192,  5036,  5236,  5225),
      Residential                        = c(2956,  2874,  3135,  2993,  2620,  2504,  2637),
      `Sum of all industry sub-sectors`  = c(2276,  2273,  2281,  2276,  2180,  2136,  2183),
      `Commercial services`              = c(1186,  1154,  1097,  1219,  1304,  1394,  1481),
      `Public services`                  = c(518,   586,   543,   546,   536,   527,   554),
      Agricultural                       = c(224,   229,   243,   240,   301,   258,   263),
      Fisheries                          = c(28,    24,    20,    19,    18,    21,    22),
      Total                              = c(12418, 12415, 11231, 11483, 11992, 12075, 12360),
      check.names = FALSE
    ) %>%
      mutate(Transport_Share_Pct = round(100 * `Sum of all transport` / Total, 1))
  })
  
  # Transport energy by sub-sector (ktoe) — Source: SEAI SEI06
  # Private car 41%, Road freight 16%, International aviation 21% of transport (2024)
  transport_subsectors <- data.frame(
    Year                   = c(2018, 2019, 2020, 2021, 2022, 2023, 2024),
    Road_Private_Car       = c(2095, 2119, 1734, 1843, 2009, 2094, 2161),
    Road_Freight           = c(734,  790,  725,  796,  790,  798,  861),
    International_Aviation = c(1098, 1111, 395,  440,  1012, 1134, 1113),
    Transport_Total        = c(5234, 5277, 3915, 4192, 5036, 5236, 5225)
  ) %>%
    mutate(Other_Transport = Transport_Total - Road_Private_Car - Road_Freight - International_Aviation)
  
  # Modal split estimates (from Census and NTA surveys)
  modal_split <- data.frame(
    Year = c(2018, 2019, 2020, 2021, 2022, 2023, 2024),
    Private_Car = c(74, 73, 70, 71, 72, 71, 70),
    Public_Transport = c(17, 18, 19, 18, 17, 18, 19),
    Active_Travel = c(9, 9, 11, 11, 11, 11, 11)
  )
  
  # Charging infrastructure (from SEAI)
  charging_points <- data.frame(
    Year = c(2018, 2019, 2020, 2021, 2022, 2023, 2024),
    Public_Chargers = c(1100, 1300, 1500, 1800, 2200, 2800, 3500),
    Fast_Chargers = c(200, 300, 400, 550, 750, 1000, 1300)
  )
  
  # Cycling infrastructure (from Transport Infrastructure Ireland)
  cycling_infrastructure <- data.frame(
    Year = c(2018, 2019, 2020, 2021, 2022, 2023, 2024),
    Cycle_Network_Km = c(1100, 1200, 1300, 1400, 1500, 1600, 1700),
    Greenways_Km = c(550, 600, 650, 700, 800, 900, 1000)
  )
  
  # Remote Working Data - FETCH FROM CSO QES20
  # Source: CSO Table QES20 - Persons in employment - Extent working at home
  cat("Fetching Remote Working data from CSO QES20...\n")
  
  remote_work <- tryCatch({
    qes20_raw <- cso_get_data("QES20")
    
    # Get all employment baseline
    all_employment <- qes20_raw %>%
      filter(Extent.of.working.at.home == "All persons in employment")
    
    # Get remote workers (usually + sometimes)
    remote_workers <- qes20_raw %>%
      filter(Extent.of.working.at.home %in% c("Person usually works at home", 
                                              "Person sometimes works at home"))
    
    # Convert to long format
    all_employment_long <- all_employment %>%
      pivot_longer(
        cols = -c(Statistic, Extent.of.working.at.home),
        names_to = "Quarter",
        values_to = "Total_Employment"
      ) %>%
      mutate(Year = as.integer(substr(Quarter, 1, 4)))
    
    remote_workers_long <- remote_workers %>%
      pivot_longer(
        cols = -c(Statistic, Extent.of.working.at.home),
        names_to = "Quarter",
        values_to = "Number_Remote"
      ) %>%
      mutate(Year = as.integer(substr(Quarter, 1, 4)))
    
    # Calculate annual averages
    remote_annual <- remote_workers_long %>%
      group_by(Year, Quarter) %>%
      summarise(Total_Remote = sum(Number_Remote, na.rm = TRUE), .groups = 'drop') %>%
      group_by(Year) %>%
      summarise(Avg_Remote = mean(Total_Remote, na.rm = TRUE), .groups = 'drop')
    
    total_annual <- all_employment_long %>%
      group_by(Year) %>%
      summarise(Avg_Employed = mean(Total_Employment, na.rm = TRUE), .groups = 'drop')
    
    # Combine and calculate percentage
    remote_work_clean <- remote_annual %>%
      left_join(total_annual, by = "Year") %>%
      mutate(
        Remote_Work_Percent = round((Avg_Remote / Avg_Employed) * 100, 1)
      ) %>%
      filter(Year >= 2016 & Year <= 2024) %>%
      arrange(Year)
    
    cat("✓ QES20 data loaded successfully from CSO API\n")
    remote_work_clean
    
  }, error = function(e) {
    cat("✗ Error loading QES20:", e$message, "\n")
    cat("Using fallback data...\n")
    
    # Fallback data (based on CSO Labour Force Survey)
    data.frame(
      Year = c(2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024),
      Avg_Remote = c(150, 160, 180, 320, 850, 750, 650, 600, 580),
      Avg_Employed = c(2200, 2250, 2300, 2350, 2300, 2350, 2450, 2500, 2550),
      Remote_Work_Percent = c(6.8, 7.1, 7.8, 13.6, 37.0, 31.9, 26.5, 24.0, 22.7)
    )
  })
  
  # Private Car VKT - FETCH FROM CSO THA10
  # Source: CSO Table THA10 - Road Traffic Volumes by Type of Vehicle
  cat("Fetching Private Car VKT from CSO THA10...\n")
  
  private_car_vkt <- tryCatch({
    # Fetch THA10 data
    tha10_raw <- cso_get_data("THA10")
    
    # THA10 comes in WIDE format: Statistic, Type.of.Vehicle, 2000, 2001, etc.
    # Step 1: Filter for Private cars
    private_cars_wide <- tha10_raw %>%
      filter(Type.of.Vehicle == "Private cars")
    
    # Step 2: Convert from wide to long (years in rows)
    private_cars_long <- private_cars_wide %>%
      pivot_longer(
        cols = -c(Statistic, Type.of.Vehicle),
        names_to = "Year",
        values_to = "VALUE"
      ) %>%
      mutate(Year = as.integer(Year)) %>%
      filter(Year >= 2016 & Year <= 2023)
    
    # Step 3: Convert to wide format with statistics as columns
    private_car_vkt_clean <- private_cars_long %>%
      select(Year, Statistic, VALUE) %>%
      pivot_wider(names_from = Statistic, values_from = VALUE) %>%
      rename(
        Vehicle_Population = `Vehicle Population (Number)`,
        Total_Million_Km = `Kilometres Travelled (Million)`,
        Average_Km = `Average Kilometres Travelled (Kilometres)`
      ) %>%
      mutate(
        Total_Billion_Km = Total_Million_Km / 1000,
        Vehicle_Population_Million = Vehicle_Population / 1000000,
        Change_vs_2019_Pct = round(((Total_Million_Km / Total_Million_Km[Year == 2019]) - 1) * 100, 1),
        Change_vs_2018_Pct = round(((Total_Million_Km / Total_Million_Km[Year == 2018]) - 1) * 100, 1)
      ) %>%
      arrange(Year)
    
    cat("✓ THA10 data loaded successfully from CSO API\n")
    private_car_vkt_clean
    
  }, error = function(e) {
    cat("✗ Error loading THA10:", e$message, "\n")
    cat("Using fallback data...\n")
    
    # Fallback to manual data if API fails
    data.frame(
      Year = c(2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023),
      Vehicle_Population = c(2050000, 2090000, 2116000, 2169000, 2203000, 2241000, 2243000, 2309000),
      Total_Million_Km = c(34000, 35000, 35959, 35465, 26010, 30117, 33200, 35126),
      Average_Km = c(16585, 16746, 16990, 16352, 11803, 13436, 14800, 15213)
    ) %>%
      mutate(
        Total_Billion_Km = Total_Million_Km / 1000,
        Vehicle_Population_Million = Vehicle_Population / 1000000,
        Change_vs_2019_Pct = round(((Total_Million_Km / 35465) - 1) * 100, 1),
        Change_vs_2018_Pct = round(((Total_Million_Km / 35959) - 1) * 100, 1)
      )
  })
  
  # Road Freight Activity - FETCH FROM CSO TFQ01
  # Source: CSO Table TFQ01 - Road Freight Transport Activity
  cat("Fetching Road Freight data from CSO TFQ01...\n")
  
  road_freight <- tryCatch({
    tfq01_raw <- cso_get_data("TFQ01")
    
    # Helper: pivot one statistic to annual totals
    annual_stat <- function(df, stat_name, col_name) {
      df %>%
        filter(Statistic == stat_name,
               Business.of.Owner == "All business activities") %>%
        pivot_longer(
          cols      = -c(Statistic, Business.of.Owner),
          names_to  = "Quarter",
          values_to = "Value"
        ) %>%
        mutate(Year = as.integer(substr(Quarter, 1, 4))) %>%
        group_by(Year) %>%
        summarise(!!col_name := round(sum(Value, na.rm = TRUE), 0),
                  .groups = "drop") %>%
        filter(Year >= 2016 & Year <= 2024)
    }
    
    tonne_km <- annual_stat(tfq01_raw, "Tonne-Kilometre",    "Tonne_Km_Million")
    km_trav  <- annual_stat(tfq01_raw, "Kilometres Travelled", "KM_Travelled_Million")
    
    freight_clean <- full_join(tonne_km, km_trav, by = "Year") %>% arrange(Year)
    
    cat("✓ TFQ01 data loaded successfully from CSO API\n")
    freight_clean
    
  }, error = function(e) {
    cat("✗ Error loading TFQ01:", e$message, "\n")
    cat("Using fallback data...\n")
    
    data.frame(
      Year             = c(2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023),
      Tonne_Km_Million = c(20891, 22314, 23046, 23498, 19872, 22105, 24301, 24518),
      KM_Travelled_Million = c(3210, 3390, 3520, 3610, 3050, 3320, 3580, 3640)
    )
  })
  
  # Road Freight Tonne-Km by NST 2007 goods group — FETCH FROM CSO TFA19
  # TFA19: Annual Road Freight by Type of Goods (NST 2007)
  cat("Fetching road freight NST goods breakdown from CSO TFA19...\n")
  
  nst_groups <- c(
    "Products of agriculture, forestry and fishing",
    "Quarry products, metal ores and peat",
    "Foodstuffs",
    "Other non-metallic mineral products"
  )
  
  freight_nst <- tryCatch({
    tfa19_raw <- cso_get_data("TFA19")
    
    cat("TFA19 columns:", paste(names(tfa19_raw), collapse = ", "), "\n")
    cat("TFA19 Statistics:", paste(unique(tfa19_raw$Statistic), collapse = " | "), "\n")
    
    # Identify the goods/NST dimension column (not Statistic)
    goods_col <- names(tfa19_raw)[grepl("Goods|NST|Commodity|Type", names(tfa19_raw), ignore.case = TRUE) &
                                    names(tfa19_raw) != "Statistic"]
    goods_col <- goods_col[1]
    cat("TFA19 goods column:", goods_col, "\n")
    cat("TFA19 goods values:", paste(unique(tfa19_raw[[goods_col]]), collapse = " | "), "\n")
    
    # Filter for Tonne-Kilometre and the four NST groups
    tfa19_raw %>%
      filter(grepl("Tonne.Kilometre|Tonne-Kilometre", Statistic, ignore.case = TRUE)) %>%
      filter(.data[[goods_col]] %in% nst_groups) %>%
      pivot_longer(
        cols      = -c(Statistic, all_of(goods_col)),
        names_to  = "Year",
        values_to = "Tonne_Km_Million"
      ) %>%
      mutate(
        Year      = as.integer(Year),
        NST_Group = .data[[goods_col]]
      ) %>%
      filter(!is.na(Tonne_Km_Million), Year >= 2014) %>%
      select(Year, NST_Group, Tonne_Km_Million) %>%
      arrange(NST_Group, Year)
    
  }, error = function(e) {
    cat("✗ Error loading TFA19:", conditionMessage(e), "\n")
    cat("Using fallback NST freight data...\n")
    
    data.frame(
      Year      = rep(c(2014, 2015, 2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023), 4),
      NST_Group = rep(nst_groups, each = 10),
      Tonne_Km_Million = c(
        # Products of agriculture, forestry and fishing
        3510, 3680, 3810, 4020, 4150, 4230, 3610, 3950, 4380, 4420,
        # Quarry products, metal ores and peat
        4510, 4720, 4920, 5180, 5340, 5510, 4610, 5040, 5580, 5640,
        # Foodstuffs
        4310, 4510, 4670, 4890, 5010, 5120, 4490, 4820, 5270, 5310,
        # Other non-metallic mineral products
        2210, 2380, 2510, 2680, 2760, 2830, 2350, 2620, 2940, 2970
      )
    )
  })
  
  # Road Freight Tonne-Km by Main Use — FETCH FROM CSO TFA01
  # TFA01: Annual Road Freight by Main Use of Vehicle
  cat("Fetching road freight by main use from CSO TFA01...\n")
  
  main_use_groups <- c(
    "Other work",
    "Import/Export work",
    "Delivery of goods to retail outlets",
    "Delivery of goods to households",
    "Delivery of goods to wholesalers",
    "Delivery of materials and fuels to factories",
    "Delivery of goods to road works or building sites",
    "Carriage of livestock",
    "Carriage of other farm produce from farms",
    "Carriage of fertilisers, feeding stuffs etc. to farms"
  )
  
  freight_main_use <- tryCatch({
    tfa01_raw <- cso_get_data("TFA01")
    
    cat("TFA01 columns:", paste(names(tfa01_raw), collapse = ", "), "\n")
    cat("TFA01 Statistics:", paste(unique(tfa01_raw$Statistic), collapse = " | "), "\n")
    
    # Identify the main use dimension column
    use_col <- names(tfa01_raw)[grepl("Use|Type|Activity|Main", names(tfa01_raw), ignore.case = TRUE) &
                                  names(tfa01_raw) != "Statistic"]
    use_col <- use_col[1]
    cat("TFA01 use column:", use_col, "\n")
    cat("TFA01 use values:", paste(unique(tfa01_raw[[use_col]]), collapse = " | "), "\n")
    
    tfa01_raw %>%
      filter(grepl("Tonne.Kilometre|Tonne-Kilometre", Statistic, ignore.case = TRUE)) %>%
      filter(.data[[use_col]] %in% main_use_groups) %>%
      pivot_longer(
        cols      = -c(Statistic, all_of(use_col)),
        names_to  = "Year",
        values_to = "Tonne_Km_Million"
      ) %>%
      mutate(
        Year      = as.integer(Year),
        Main_Use  = .data[[use_col]]
      ) %>%
      filter(!is.na(Tonne_Km_Million), Year >= 2014) %>%
      select(Year, Main_Use, Tonne_Km_Million) %>%
      arrange(Main_Use, Year)
    
  }, error = function(e) {
    cat("✗ Error loading TFA01:", conditionMessage(e), "\n")
    cat("Using fallback main use freight data...\n")
    
    data.frame(
      Year     = rep(c(2014, 2015, 2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023), 10),
      Main_Use = rep(main_use_groups, each = 10),
      Tonne_Km_Million = c(
        # Other work
        2810, 2950, 3080, 3210, 3290, 3360, 2870, 3100, 3420, 3450,
        # Import/Export work
        3940, 4120, 4290, 4480, 4610, 4710, 4020, 4350, 4790, 4830,
        # Delivery of goods to retail outlets
        2180, 2280, 2380, 2490, 2550, 2610, 2220, 2410, 2650, 2680,
        # Delivery of goods to households
        390, 410, 430, 450, 460, 470, 560, 670, 790, 820,
        # Delivery of goods to wholesalers
        1420, 1490, 1550, 1620, 1660, 1700, 1450, 1570, 1730, 1750,
        # Delivery of materials and fuels to factories
        1730, 1810, 1890, 1970, 2020, 2070, 1760, 1910, 2100, 2120,
        # Delivery of goods to road works or building sites
        1560, 1640, 1710, 1790, 1840, 1880, 1520, 1680, 1920, 1960,
        # Carriage of livestock
        360, 380, 390, 410, 420, 430, 370, 400, 440, 450,
        # Carriage of other farm produce from farms
        680, 710, 740, 770, 790, 810, 690, 750, 830, 840,
        # Carriage of fertilisers, feeding stuffs etc. to farms
        520, 540, 570, 590, 610, 620, 530, 580, 640, 650
      )
    )
  })
  
  # Passenger Journeys by Public Transport - FETCH FROM CSO THA25
  # Source: CSO Table THA25 - Passenger Journeys by Public Transport
  cat("Fetching Public Transport data from CSO THA25...\n")
  
  public_transport <- tryCatch({
    tha25_raw <- cso_get_data("THA25")
    
    # THA25 comes in WIDE format: Statistic, Mode.of.Transport, weeks as columns
    # Filter for Passenger Journeys
    pt_wide <- tha25_raw %>%
      filter(Statistic == "Passenger Journeys")
    
    # Convert from wide to long
    pt_long <- pt_wide %>%
      pivot_longer(
        cols = -c(Statistic, Mode.of.Transport),
        names_to = "Week",
        values_to = "Journeys"
      ) %>%
      mutate(Year = as.integer(substr(Week, 1, 4)))
    
    # Calculate annual totals by mode
    pt_annual <- pt_long %>%
      group_by(Year, Mode.of.Transport) %>%
      summarise(
        Total_Journeys = sum(Journeys, na.rm = TRUE) / 1000000,  # Convert to millions
        .groups = 'drop'
      ) %>%
      filter(Year >= 2016 & Year <= 2024)
    
    # Reshape to have modes as columns (matching expected format)
    pt_clean <- pt_annual %>%
      pivot_wider(
        names_from = Mode.of.Transport,
        values_from = Total_Journeys
      ) %>%
      arrange(Year)
    
    cat("✓ THA25 data loaded successfully from CSO API\n")
    pt_clean
    
  }, error = function(e) {
    cat("✗ Error loading THA25:", e$message, "\n")
    cat("Using fallback data...\n")
    
    # Fallback public transport data
    data.frame(
      Year = c(2018, 2019, 2020, 2021, 2022, 2023, 2024),
      Bus_Journeys = c(235, 228, 120, 119, 180, 220, 250),
      Rail_Journeys = c(46, 48, 25, 35, 40, 46, 52),
      Luas_Journeys = c(37, 40, 18, 20, 28, 34, 38),
      Total_PT_Journeys = c(318, 316, 163, 174, 248, 300, 340)
    )
  })
  
  # ============================================================================
  # SHIFT TAB DATA FETCHES — all confirmed against CSO PxStat API
  # ============================================================================
  
  # Bus passenger services (TOA16) — annual 2011-2024, 4 service types
  # IMPORTANT: TOA16 raw values are in THOUSANDS, not raw passenger counts.
  # Divide by 1e3 to convert to millions, not 1e6 (which gave values 1000x
  # too small in earlier versions).
  cat("Fetching bus passenger services from CSO TOA16...\n")
  pt_bus_services <- tryCatch({
    toa16_raw <- cso_get_data("TOA16")
    toa16_raw %>%
      filter(Statistic == "Passengers") %>%
      pivot_longer(
        cols = -c(Statistic, Scheduled.services),
        names_to = "Year", values_to = "Passengers_Millions"
      ) %>%
      mutate(
        Year = as.integer(Year),
        Passengers_Millions = round(Passengers_Millions / 1e3, 2)
      ) %>%
