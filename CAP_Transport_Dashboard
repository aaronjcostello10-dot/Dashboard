        hovertemplate = "<b>%{x}</b> actual: %{y:.1f}%<extra></extra>"
      ) %>%
      add_trace(
        x = 2030, y = 14,
        type = "scatter", mode = "markers+text",
        name = "2030 target",
        marker = list(size = 12, color = "#00959f", symbol = "diamond"),
        text = "2030 target\n14%",
        textposition = "middle right",
        textfont = list(color = "#00959f", size = 11),
        hovertemplate = "<b>2030 target</b>: 14%<extra></extra>",
        showlegend = FALSE
      ) %>%
      layout(
        xaxis = list(title = "Year", range = c(2017.5, 2031.5),
                     showgrid = FALSE, showline = FALSE, ticks = "outside", dtick = 2),
        yaxis = list(title = "Biofuel blend rate (%)", range = c(0, 18),
                     gridcolor = "#e8ecf4", gridwidth = 1,
                     showline = FALSE, zeroline = FALSE),
        hovermode = "x unified",
        legend = list(orientation = "h", x = 0, y = -0.2)
      )
  })
  
  # ========================================================================
  # OVERVIEW TAB — KPI INFOBOXES
  # ========================================================================
  
  # Headline 1: Transport emissions vs 2018 baseline (CAP 2025 headline metric)
  output$kpi_emissions <- renderInfoBox({
    latest_em <- data$emissions %>% filter(Year == max(Year))
    base_em <- data$emissions %>% filter(Year == 2018) %>% pull(Transport_Emissions)
    delta <- round((latest_em$Transport_Emissions - base_em) / base_em * 100, 1)
    sign <- ifelse(delta >= 0, "+", "")
    infoBox(
      paste0("Emissions (", latest_em$Year, ")"),
      paste0(latest_em$Transport_Emissions, " MtCO\u2082eq"),
      paste0(sign, delta, "% vs 2018 baseline (CAP target: −50% by 2030)"),
      icon  = icon("smog"),
      color = "red"
    )
  })
  
  # Headline 2: Private Car VKT vs 2019 baseline (CAP 2025 Avoid flagship)
  output$kpi_ev_share <- renderInfoBox({
    latest_vkt <- data$private_car_vkt %>% filter(Year == max(Year))
    base_vkt <- data$private_car_vkt %>% filter(Year == 2019) %>% pull(Total_Billion_Km)
    delta <- round((latest_vkt$Total_Billion_Km - base_vkt) / base_vkt * 100, 1)
    sign <- ifelse(delta >= 0, "+", "")
    infoBox(
      paste0("Private Car VKT (", latest_vkt$Year, ")"),
      paste0(round(latest_vkt$Total_Billion_Km, 1), " Bn km"),
      paste0(sign, delta, "% vs 2019 (CAP target: −20% by 2030)"),
      icon  = icon("road"),
      color = "orange"
    )
  })
  
  # Headline 3: EV share of new private cars (CAP 2025 Improve flagship)
  output$kpi_pt_journeys <- renderInfoBox({
    ev <- data$new_cars_fuel %>%
      filter(Category == "New Private Cars") %>%
      group_by(Year) %>%
      summarise(
        Total = sum(Count, na.rm = TRUE),
        Electric = sum(Count[Fuel == "Electric"], na.rm = TRUE),
        .groups = "drop"
      ) %>%
      mutate(EV_Pct = round(100 * Electric / Total, 1)) %>%
      filter(Year == max(Year))
    infoBox(
      paste0("New EV Share (", ev$Year, ")"),
      paste0(ev$EV_Pct, "%"),
      "Pure electric share of new private cars licensed",
      icon  = icon("bolt"),
      color = "green"
    )
  })
  
  # Headline 4: Remote working (Avoid behavioural lever)
  output$kpi_remote_work <- renderInfoBox({
    latest_rw <- data$remote_work %>% filter(Year == max(Year))
    infoBox(
      paste0("Remote Working (", latest_rw$Year, ")"),
      paste0(latest_rw$Remote_Work_Percent, "%"),
      "Workforce working at or from home",
      icon  = icon("house-laptop"),
      color = "blue"
    )
  })
  
  # ========================================================================
  # OVERVIEW TAB — EMISSIONS VS CAP 2030 TARGET PATHWAY
  # ========================================================================
  
  output$overview_emissions_target_plot <- renderPlotly({
    # Linear target pathway per CAP 2025 Chapter 14:
    # 2018 baseline = 12.3 MtCO2eq, 2030 target = 6.1 MtCO2eq (50% reduction)
    baseline_yr  <- 2018
    baseline_mt  <- 12.3
    target_yr    <- 2030
    target_mt    <- 6.1
    
    target_pathway <- data.frame(
      Year      = seq(baseline_yr, target_yr),
      Target_Mt = seq(baseline_mt, target_mt, length.out = target_yr - baseline_yr + 1)
    )
    
    plot_ly() %>%
      add_trace(
        data = data$emissions,
        x = ~Year, y = ~Transport_Emissions,
        type = 'scatter', mode = 'lines+markers',
        name = 'Actual Emissions',
        line   = list(color = '#d32f2f', width = 3),
        marker = list(size = 10),
        hovertemplate = '%{y:.1f} MtCO\u2082eq<extra></extra>'
      ) %>%
      add_trace(
        data = target_pathway,
        x = ~Year, y = ~Target_Mt,
        type = 'scatter', mode = 'lines',
        name = 'CAP 2030 Target Pathway',
        line = list(color = 'gray', dash = 'dash', width = 2),
        hovertemplate = '%{y:.1f} MtCO\u2082eq (target)<extra></extra>'
      ) %>%
      layout(
        xaxis = list(title = "Year", range = list(2017, 2031)),
        yaxis = list(title = "Transport Emissions (MtCO\u2082eq)", range = list(0, 14)),
        hovermode = 'x unified',
        legend = list(x = 0.55, y = 0.98)
      )
  })
}

